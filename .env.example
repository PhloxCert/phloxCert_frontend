# Frontend environment variables (rename to .env and fill with real values)

# Backend API base URL (used for login / data fetch)
VITE_API_BASE_URL=http://localhost:8080

# IOTA node URL for dapp-kit / wallet connections
VITE_IOTA_NODE_URL=http://127.0.0.1:9000

# Smart contract identifiers (must match your backend / Move contract deployment)
VITE_PACKAGE_ID= # Package Id deployed Registry Contract
VITE_REGISTRY_ID= # Object Id deployed Registry
